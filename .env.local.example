# Connexion à la base de données PostgreSQL locale (docker-compose.yml)
DATABASE_URL="postgresql://options_tracker:options_tracker@localhost:5433/options_tracker?schema=public"

# Secret de session NextAuth — générer avec `openssl rand -base64 32`
NEXTAUTH_SECRET=""

# Clé de chiffrement AES-256-GCM du secret TOTP (2FA) — 32 octets en hexadécimal,
# générer avec `openssl rand -hex 32`. Ne doit jamais être committée ni changée
# une fois des secrets 2FA stockés (les secrets existants deviendraient illisibles).
TWO_FACTOR_ENCRYPTION_KEY=""
