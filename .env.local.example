# Connexion à la base de données PostgreSQL locale (docker-compose.yml)
DATABASE_URL="postgresql://options_tracker:options_tracker@localhost:5433/options_tracker?schema=public"

# Secret de session NextAuth — générer avec `openssl rand -base64 32`
NEXTAUTH_SECRET=""

# Clé de chiffrement AES-256-GCM du secret TOTP (2FA) — 32 octets en hexadécimal,
# générer avec `openssl rand -hex 32`. Ne doit jamais être committée ni changée
# une fois des secrets 2FA stockés (les secrets existants deviendraient illisibles).
TWO_FACTOR_ENCRYPTION_KEY=""

# URL du Client Portal Gateway IBKR — local en Phase 1/2, VPS dédié en
# Phase 3. Le certificat auto-signé du Gateway n'est accepté que si
# NODE_ENV=development (cf. src/lib/ibkr-gateway/client.ts).
# Port 5001 ici (et non 5000, le défaut du Gateway) : sur macOS, le port 5000
# est fréquemment occupé par le récepteur AirPlay de ControlCenter — même
# type de conflit que Postgres 5432→5433 (cf. CLAUDE.md). Adapter selon la
# valeur de `listenPort` dans root/conf.yaml de votre propre installation du
# Client Portal Gateway (clientportal.gw).
IBKR_GATEWAY_URL="https://localhost:5001"
